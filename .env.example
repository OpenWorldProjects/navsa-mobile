# Optional public HTTPS telemetry proxy for a hosted web build.
# Must return the NAVSA /live JSON array and allow this website's origin via CORS.
# Native Android requests use CapacitorHttp directly; local development uses Vite /api/live.
# GitHub Pages cannot provide the Vite proxy. Do not place secrets in VITE_ variables.
VITE_NAVSA_LIVE_URL=
